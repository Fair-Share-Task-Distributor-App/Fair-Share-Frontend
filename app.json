{
  "expo": {
    "name": "Task Distributor: Fair Share",
    "slug": "task-distributor-fair-share",
    "version": "1.0.2",
    "orientation": "portrait",
    "icon": "./assets/images/playstore-icon.png",
    "scheme": "com.thetwai.fairshare",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.thetwai.fairshare",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/playstore-icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.thetwai.fairshare"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      ["@react-native-google-signin/google-signin"],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-secure-store",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4ce6ec40-616c-4b4b-8d44-2cb60f1a2375"
      }
    },
    "owner": "thet_wai",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/b2e3026f-8e91-4bd1-a1b5-d0fb65e61fd0"
    }
  }
}
